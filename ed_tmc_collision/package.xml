<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ed_tmc_collision</name>
  <version>0.1.0</version>
  <description>Plugin for the ED world model to generate TMC collision environments for motion planning</description>

  <maintainer email="MatthijsBurgh@outlook.com">Matthijs van der Burgh</maintainer>

  <license>TODO</license>

  <url type="repository">http://github.com/tue-robotics/ed_tmc_collision.git</url>
  <url type="bugtracker">http://github.com/tue-robotics/ed_tmc_collision/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ed</depend>
  <depend>ed_tmc_collision_interfaces</depend>
  <depend>libboost-filesystem-dev</depend>
  <depend>geolib2</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tmc_geometric_shapes_msgs</depend>
  <depend>tmc_manipulation_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
